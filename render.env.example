# Render (or any cloud host): set these in the service **Environment** tab.
#
# --- Backend web service ---
# CORS must allow your deployed frontend origin (NODE_ENV=production uses CLIENT_URL).
NODE_ENV=production
CLIENT_URL=https://finwise-canary-frontend.onrender.com
# Plus: MONGODB_URI, SESSION_SECRET_KEY, JWT_SECRET, OAUTH_*, AI_*, etc. (same as server/.env locally)

# --- Frontend static site / Docker build on Render ---
# If you build on Render without committing .env.production, set:
# VITE_SERVER_URL=https://finwise-canary-backend.onrender.com
# VITE_SERVER_URL_DEVELOPMENT=https://finwise-canary-backend.onrender.com
# VITE_OAUTH_CLIENT_ID=<same as Google Cloud client id>
# VITE_CHAT_RESPONSE_MODE=streaming
