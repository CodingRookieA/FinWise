# Copy to `.env` for local development (see `.gitignore`).
# Production builds use `.env.production` when you run `vite build`.

VITE_OAUTH_CLIENT_ID=
# Local API (npm run dev). Production API URL lives in .env.production as VITE_SERVER_URL.
VITE_SERVER_URL_DEVELOPMENT=http://localhost:9000
VITE_CHAT_RESPONSE_MODE=streaming
