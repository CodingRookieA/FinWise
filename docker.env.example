# Optional root `.env` (next to docker-compose.yml) — only for Compose substitution
# like FRONTEND_PORT. Docker Compose loads it automatically if present.
#
# Frontend Vite config: use `client/.env` (gitignored). It is included in the Docker build
# context so `vite build` reads VITE_* (including OAuth) — no extra flags needed.
#
# Backend: `server/.env` is loaded via compose `env_file` on the backend service.
#
# FRONTEND_PORT=5173
