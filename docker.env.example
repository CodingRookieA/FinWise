# Copy to `.env` in this directory (same folder as docker-compose.yml) before running:
#   copy docker.env.example .env   (Windows)
#   cp docker.env.example .env     (Unix)

FRONTEND_PORT=8080

# Required for the API (match values you use in server/.env for local dev)
SESSION_SECRET_KEY=
JWT_SECRET=

# OAuth (optional; leave empty if unused)
OAUTH_CLIENT_ID=
OAUTH_SECRET_KEY=
VITE_OAUTH_CLIENT_ID=

# Email (optional)
MAILTRAP_API_TOKEN=

# AI / chat (optional depending on features you use)
GEMINI=
AI_EMBEDDING_URL=
AI_EMBEDDING_API_KEY=
AI_GENERAL_URL=
AI_GENERAL_API_KEY=
