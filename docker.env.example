# Optional root `.env` (next to docker-compose.yml) — only for Compose substitution
# like FRONTEND_PORT. Docker Compose loads it automatically if present.
#
# Local Docker: use gitignored `client/.env` with localhost API URLs.
# Cloud (Render): `client/.env.production` sets public API URLs for `vite build`; backend needs
# `CLIENT_URL` = your frontend HTTPS origin — see `render.env.example`.
#
# Backend: `server/.env` is loaded via compose `env_file` on the backend service.
#
# FRONTEND_PORT=8080
